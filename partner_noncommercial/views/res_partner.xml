<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_res_partner_filter" model="ir.ui.view">
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="model">res.partner</field>
        <field name="mode">extension</field>
        <field type="xml" name="arch">
            <!-- Default type_person also contains invoice and delivery
                 addresses for companies (and persons). -->
            <filter name="type_person" position="attributes">
                <attribute
                    name="domain"
                    operation="domain_add"
                >[('type', '=', 'contact')]</attribute>
            </filter>

            <!-- Change string of Company filter to Organizations. -->
            <filter name="type_company" position="attributes">
                <attribute name="string">Organizations</attribute>
            </filter>

            <filter name="group_company" position="attributes">
                <attribute name="string">Organization</attribute>
            </filter>

            <!-- Rename salesperson to responsible -->
            <filter name="salesperson" position="attributes">
                <attribute name="string">Responsible</attribute>
            </filter>

            <!-- Add extra filters. -->
            <filter name="inactive" position="after">
                <separator />
                <filter
                    string="With email"
                    name="filter_email"
                    domain="[('email', '!=', False)]"
                />
                <filter
                    string="With address"
                    name="filter_address"
                    domain="[('street', '!=', False), ('street', '!=', ''),
                             ('city', '!=', False), ('city', '!=', '')]"
                />
            </filter>

            <!-- Add extra groupings. -->
            <filter name="group_country" position="after">
                <filter name="group_city" context="{'group_by': 'city'}" />
            </filter>
        </field>
    </record>
    <record id="view_partner_simple_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_simple_form" />
        <field name="arch" type="xml">
            <!-- Change placeholders -->
            <field name="parent_id" position="attributes">
                <attribute name="placeholder">Organization Name...</attribute>
            </field>
        </field>
    </record>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- Change placeholders -->
            <xpath expr="//h1/field[@invisible='not is_company']" position="attributes">
                <attribute name="placeholder">e.g. Unicef</attribute>
            </xpath>
            <field name="parent_id" position="attributes">
                <attribute name="placeholder">Organization Name...</attribute>
            </field>
            <field name="function" position="attributes">
                <attribute name="placeholder">e.g. Board Member</attribute>
            </field>
            <!-- Change tab titles -->
            <page name="sales_purchases" position="attributes">
                <attribute name="string">Details</attribute>
            </page>
        </field>
    </record>
</odoo>
