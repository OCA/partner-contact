<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">partner_contact_tags_in_popup.view_partner_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//notebook/page/field[@name='child_ids']/form/sheet//field[@name='phone']/parent::div"
                position="after"
            >
                <div class="d-flex align-items-baseline">
                    <i class="fa fa-fw me-1 fa-tags text-primary" title="Tags" />
                    <field
                        name="category_id"
                        widget="many2many_tags"
                        options="{'color_field': 'color'}"
                        class="w-100"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
