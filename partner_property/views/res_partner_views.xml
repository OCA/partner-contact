<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.property.scope</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='properties'][not(ancestor::field)]"
                position="before"
            >
                <!-- The widget evaluates each property's scope using is_company.
                     Widget template expressions are not detected as view dependencies. -->
                <field name="is_company" invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
