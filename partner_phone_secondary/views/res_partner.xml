<odoo>
    <record id="view_partner_simple_form" model="ir.ui.view">
        <field name="name">res.partner.simplified.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_simple_form" />
        <field name="priority" eval="20" />
        <field name="arch" type="xml">
            <field name="phone" position="after">
                <field name="phone2_sanitized" invisible="1" />
                <field name="phone2_formatted" invisible="1" />
                <field name="phone2" widget="phone" />
            </field>
        </field>
    </record>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="priority" eval="20" />
        <field name="arch" type="xml">
            <xpath expr="/form/sheet//field[@name='phone']/.." position="after">
                <div class="d-flex align-items-baseline w-md-50 gap-2">
                    <i
                        class="oi oi-filled d-none d-md-block"
                        data-icon="phone"
                        title="Phone"
                    />
                    <field name="phone2_sanitized" invisible="1" />
                    <field name="phone2_formatted" invisible="1" />
                    <field
                        name="phone2"
                        class="w-100"
                        widget="phone"
                        placeholder="Phone2"
                    />
                </div>
            </xpath>
            <xpath expr="//field[@name='child_ids']/kanban/templates" position="before">
                <field name="phone2_sanitized" />
                <field name="phone2_formatted" />
            </xpath>
            <xpath
                expr="//field[@name='child_ids']/kanban/templates//div[@t-if='record.phone.raw_value']"
                position="after"
            >
                <div t-if="record.phone2.raw_value">
                    <i
                        class="oi oi-fw oi-filled me-1"
                        data-icon="phone"
                        title="Phone2"
                    />
                    <field name="phone2" />
                </div>
            </xpath>
            <xpath
                expr="//field[@name='child_ids']/form/sheet//field[@name='phone']/.."
                position="after"
            >
                <label for="phone2" string="Phone (Secondary)" class="d-md-none" />
                <div class="d-flex align-items-baseline w-md-50 gap-2">
                    <i
                        class="oi oi-filled d-none d-md-block"
                        data-icon="phone"
                        title="Phone (Secondary)"
                    />
                    <field name="phone2_sanitized" invisible="1" />
                    <field name="phone2_formatted" invisible="1" />
                    <field name="phone2" widget="phone" placeholder="Phone2" />
                </div>
            </xpath>
        </field>
    </record>

    <record id="res_partner_kanban_view" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.res_partner_kanban_view" />
        <field name="priority" eval="20" />
        <field name="arch" type="xml">
            <xpath expr="//templates" position="before">
                <field name="phone2_sanitized" />
                <field name="phone2_formatted" />
            </xpath>
            <div t-if="record.phone.raw_value" position="after">
                <div t-if="record.phone2.raw_value" class="d-flex align-items-baseline">
                    <i
                        class="oi oi-fw oi-filled me-1 text-muted"
                        data-icon="phone"
                        title="Phone2"
                    />
                    <field name="phone2" widget="phone" />
                </div>
            </div>
        </field>
    </record>

    <record id="view_partner_tree" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree" />
        <field name="priority" eval="20" />
        <field name="arch" type="xml">
            <field name="phone" position="after">
                <field name="phone2_sanitized" column_invisible="1" />
                <field name="phone2_formatted" column_invisible="1" />
                <field
                    name="phone2"
                    optional="hide"
                    class="o_force_ltr"
                    widget="phone"
                />
            </field>
        </field>
    </record>
</odoo>
