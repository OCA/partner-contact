<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_form_store_details" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.store_details</field>
        <field name="model">res.partner</field>
        <field name="priority">50</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='contact_addresses']/field[@name='child_ids']/form/sheet/group[1]/group[2]"
                position="inside"
            >
                <field name="opening_hours" invisible="type != 'store'" />
            </xpath>
            <xpath expr="//page[@name='sales_purchases']/group" position="inside">
                <group
                    name="store_details"
                    string="Store Details"
                    invisible="type != 'store'"
                >
                    <field name="opening_hours" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
