<odoo>

    <record id="view_partner_form_address_lock" model="ir.ui.view">
        <field name="name">res.partner.form.address.lock</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page
                    string="Address History"
                    name="address_history"
                    attrs="{'invisible': ['|', ('parent_id', '!=', False), ('address_history_html', '=', False)]}"
                >
                        <field
                        name="address_history_html"
                        widget="html"
                        readonly="1"
                        nolabel="1"
                    />
                </page>
            </notebook>
        </field>
    </record>

</odoo>
