<odoo>
    <record id="res_partner_revenue_range_action" model="ir.actions.act_window">
        <field name="name">Revenue ranges</field>
        <field name="res_model">res.partner.revenue_range</field>
        <field name="view_mode">list</field>
    </record>
    <record id="res_partner_revenue_range_list_view" model="ir.ui.view">
        <field name="name">Revenue range list</field>
        <field name="model">res.partner.revenue_range</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="name" />
            </list>
        </field>
    </record>
    <menuitem
        id="menu_res_partner_revenue_range"
        action="res_partner_revenue_range_action"
        parent="contacts.res_partner_menu_config"
    />
</odoo>
