<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit (in partner_google_reviews)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_geolocalize.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='base_geolocalize']" position="after">
                <setting
                    id="google_places_api_params"
                    string="Google Places API"
                    help="Get Google Reviews for your Contacts."
                >
                    <div>
                        API:
                        <field
                        name="google_places_api_key"
                        id="google_places_api_key"
                    />
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
