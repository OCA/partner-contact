<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_history_change_form" model="ir.ui.view">
        <field name="name">Partner History Change Form</field>
        <field name="model">res.partner.history.change</field>
        <field name="arch" type="xml">
            <form string="Partner History Change">
                <sheet>
                    <group>
                        <field name="partner_id" />
                        <field name="name" />
                        <field name="street" />
                        <field name="street2" />
                        <field name="city" />
                        <field name="state_id" />
                        <field name="zip" />
                        <field name="country_id" />
                        <field name="date_change" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_partner_history_change_tree" model="ir.ui.view">
        <field name="name">Partner History Change Tree</field>
        <field name="model">res.partner.history.change</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="partner_id" invisible="1" />
                <field name="name" />
                <field name="street" />
                <field name="street2" />
                <field name="city" />
                <field name="state_id" />
                <field name="zip" />
                <field name="country_id" />
                <field name="date_change" />
            </tree>
        </field>
    </record>
</odoo>
