<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="tree_res_partner_relation_all" model="ir.ui.view">
        <field name="model">res.partner.relation.all</field>
        <field
            name="inherit_id"
            ref="partner_multi_relation.tree_res_partner_relation_all"
        />
        <field name="arch" type="xml">
            <field name="other_partner_id" position="after">
                <field name="allow_email" invisible="1" />
                <field name="allow_phone" invisible="1" />
                <field name="allow_address" invisible="1" />
                <field
                    name="email"
                    optional="hide"
                    attrs="{'readonly': [('allow_email','=',False)]}"
                />
                <field
                    name="phone"
                    optional="hide"
                    attrs="{'readonly': [('allow_phone','=',False)]}"
                />
                <field
                    name="mobile"
                    optional="hide"
                    attrs="{'readonly': [('allow_phone','=',False)]}"
                />
            </field>
        </field>
    </record>

    <record id="search_res_partner_relation_all" model="ir.ui.view">
        <field name="model">res.partner.relation.all</field>
        <field
            name="inherit_id"
            ref="partner_multi_relation.search_res_partner_relation_all"
        />
        <field name="arch" type="xml">
            <field name="other_partner_id" position="after">
                <field name="email" />
            </field>
        </field>
    </record>

    <!-- Alternate tree view, to show address information, and linked to form. -->
    <record id="tree_res_partner_relation_address" model="ir.ui.view">
        <field name="name">res.partner.relation.all.address.tree</field>
        <field name="model">res.partner.relation.all</field>
        <field name="priority" eval="32" />
        <field name="arch" type="xml">
            <tree
                decoration-primary="date_start and date_start &gt; current_date"
                decoration-warning="active and date_end"
                decoration-muted="not active"
            >
                <field name="display_name" />
                <field name="email" optional="show" />
                <field name="phone" optional="show" />
                <field name="mobile" optional="show" />
                <field name="street" optional="hide" />
                <field name="zipcode" optional="hide" />
                <field name="city" optional="hide" />
                <field name="country_id" optional="hide" />
                <field name="date_start" optional="hide" />
                <field name="date_end" optional="hide" />
                <field name="active" optional="hide" />
            </tree>
        </field>
    </record>
    <record id="form_res_partner_relation_address" model="ir.ui.view">
        <field name="name">res.partner.relation.all.address.form</field>
        <field name="model">res.partner.relation.all</field>
        <field name="priority" eval="32" />
        <field name="arch" type="xml">
            <form>
                <field name="allow_email" invisible="1" />
                <field name="allow_phone" invisible="1" />
                <field name="allow_address" invisible="1" />
                <sheet>
                    <group
                        name="group_relation_basic"
                        string="Basic Info"
                        colspan="4"
                        col="2"
                    >
                        <field
                            name="this_partner_id"
                            required="True"
                            options="{'no_create': True}"
                        />
                        <field
                            name="type_selection_id"
                            required="True"
                            options="{'no_create': True}"
                        />
                        <field
                            name="other_partner_id"
                            required="True"
                            options="{'no_create': True}"
                        />
                        <field name="date_start" />
                        <field name="date_end" />
                    </group>
                    <group
                        name="group_relation_email"
                        string="Email Info"
                        colspan="4"
                        col="2"
                        attrs="{'invisible': [('allow_email','=',False)]}"
                    >
                        <field name="email" />
                    </group>
                    <group
                        name="group_relation_phone"
                        string="Phone Info"
                        colspan="4"
                        col="2"
                        attrs="{'invisible': [('allow_phone','=',False)]}"
                    >
                        <field name="phone" />
                        <field name="mobile" />
                    </group>
                    <group
                        name="group_relation_address"
                        string="Address Info"
                        colspan="4"
                        col="2"
                        attrs="{'invisible': [('allow_address','=',False)]}"
                    >
                        <field name="street" />
                        <field name="zipcode" />
                        <field name="city" />
                        <field name="country_id" options="{'no_create': True}" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
