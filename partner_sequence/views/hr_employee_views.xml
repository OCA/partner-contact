<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_employee_view_form_custom" model="ir.ui.view">
        <field name="name">hr.employee.form.custom.id</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group" position="inside">
                <field name="x_employee_id" />
            </xpath>
        </field>
    </record>

    <record id="hr_employee_tree_custom" model="ir.ui.view">
        <field name="name">hr.employee.tree.custom.id</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="x_employee_id" />
            </xpath>
        </field>
    </record>
</odoo>
