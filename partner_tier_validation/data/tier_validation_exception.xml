<odoo noupdate="1">
    <record
        id="partner_tier_validation_exception_stage"
        model="tier.validation.exception"
    >
        <field name="name">Stage Exception</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field
            name="field_ids"
            eval="[(6, 0, [ref('partner_stage.field_res_partner__stage_id')])]"
        />
        <field name="allowed_to_write_under_validation" eval="False" />
        <field name="allowed_to_write_after_validation" eval="True" />
        <field name="group_ids" eval="[(6, 0, [ref('base.group_user')])]" />
    </record>

    <record
        id="partner_tier_validation_exception_state"
        model="tier.validation.exception"
    >
        <field name="name">State Exception</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field
            name="field_ids"
            eval="[(6, 0, [ref('partner_stage.field_res_partner__state')])]"
        />
        <field name="allowed_to_write_under_validation" eval="False" />
        <field name="allowed_to_write_after_validation" eval="True" />
        <field name="group_ids" eval="[(6, 0, [ref('base.group_user')])]" />
    </record>
</odoo>
