<odoo>
    <!-- odoo adds the widget="phone" for list and kanban views in the module 'phone_validation',
    which adds an unnecessary inherit... so we do it here directly -->
    <record id="view_partner_tree" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree" />
        <field name="arch" type="xml">
            <field name="phone" position="after">
                <field
                    name="mobile"
                    optional="show"
                    class="o_force_ltr"
                    widget="phone"
                    options="{'formatted_field': 'mobile_formatted', 'dial_field': 'mobile_sanitized'}"
                />
            </field>
        </field>
    </record>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="/form/sheet//field[@name='phone']/.." position="after">
                <label for="phone" class="d-md-none" />
                <div class="d-flex align-items-baseline w-md-50 gap-2" name="mobile">
                    <i
                        class="oi oi-filled d-none d-md-inline-flex"
                        data-icon="smartphone"
                        title="Mobile"
                    />
                    <field
                        name="mobile"
                        widget="phone"
                        placeholder="Mobile"
                        formatted_field="mobile_formatted"
                        dial_field="mobile_sanitized"
                    />
                </div>
            </xpath>

            <xpath
                expr="//field[@name='child_ids']/kanban/templates//div[@t-if='record.phone.raw_value']"
                position="after"
            >
                <div t-if="record.mobile.raw_value" name="mobile-child-kanban">
                    <i
                        class="oi oi-fw oi-filled me-1"
                        data-icon="smartphone"
                        title="Mobile"
                    />
                    <field
                        name="mobile"
                        widget="phone"
                        placeholder="Mobile"
                        options="{'formatted_field': 'mobile_formatted', 'dial_field': 'mobile_sanitized'}"
                    />
                </div>
            </xpath>
            <xpath
                expr="//field[@name='child_ids']/form/sheet//field[@name='phone']/.."
                position="after"
            >
                <label for="mobile" class="d-md-none" />
                <div
                    class="d-flex align-items-baseline w-md-50 gap-2"
                    name="mobile-child-form"
                >
                    <i
                        class="oi oi-filled d-none d-md-block"
                        data-icon="smartphone"
                        title="Mobile"
                    />
                    <field
                        name="mobile"
                        widget="phone"
                        placeholder="Mobile"
                        formatted_field="mobile_formatted"
                        dial_field="mobile_sanitized"
                    />
                </div>
            </xpath>
        </field>
    </record>

    <!--
        No need to inherit the search view of res.partner:
        in the module phone_validation, they already handle the fact
        that <field name="phone"/> will search both on 'phone' and 'mobile' fields
    -->

    <record id="res_partner_kanban_view" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.res_partner_kanban_view" />
        <field name="arch" type="xml">
            <div t-if="record.phone.raw_value" position="after">
                <div t-if="record.mobile.raw_value" class="d-flex align-items-baseline">
                    <i
                        class="oi oi-fw oi-filled me-1 text-muted"
                        data-icon="smartphone"
                        title="Mobile"
                    />
                    <field
                        name="mobile"
                        widget="phone"
                        placeholder="Mobile"
                        options="{'formatted_field': 'mobile_formatted', 'dial_field': 'mobile_sanitized'}"
                    />
                </div>
            </div>
        </field>
    </record>

    <record id="view_partner_simple_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_simple_form" />
        <field name="arch" type="xml">
            <field name="phone" position="after">
                <field
                    name="mobile"
                    widget="phone"
                    formatted_field="mobile_formatted"
                    dial_field="mobile_sanitized"
                />
            </field>
        </field>
    </record>
</odoo>
