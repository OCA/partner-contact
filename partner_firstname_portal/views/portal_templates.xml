<odoo>
    <template
        id="partner_firstname_portal.portal_my_details_fields"
        inherit_id="portal.portal_my_details_fields"
    >
        <!--
            display company_type in a similar way as in back-office
            Note, the customer / supplier doesn't have the possibility to change this field,
            because it can generate huge problem in term of invoices, etc.
        -->
        <xpath expr="//input[@name='name']/.." position="before">
            <div class="mb-3 col-xl-6 form-check o_radio_item">
                <input
                    class="form-check-input o_radio_input"
                    type="radio"
                    name="company_type"
                    value="person"
                    id="company_type_person"
                    t-att-checked="not partner.is_company"
                    disabled="disabled"
                />
                <label
                    for="company_type_person"
                    class="form-check-label o_form_label"
                >Individual</label>
            </div>
            <div class="mb-3 col-xl-6 form-check o_radio_item">
                <input
                    class="form-check-input o_radio_input"
                    type="radio"
                    name="company_type"
                    value="company"
                    id="company_type_company"
                    t-att-checked="partner.is_company"
                    disabled="disabled"
                />
                <label
                    for="company_type_company"
                    class="form-check-label o_form_label"
                >Company</label>
            </div>
        </xpath>

        <!--
            If it's a company, hide 'company_name' field, that doesn't make sense
        -->
        <xpath expr="//input[@name='company_name']/.." position="attributes">
            <attribute name="t-att-hidden">partner.is_company</attribute>
        </xpath>

        <!--
            If it's an individual, hide name field, and display firstname lastname fields
        -->
        <xpath expr="//input[@name='name']/.." position="attributes">
            <attribute name="t-att-hidden">not partner.is_company</attribute>
        </xpath>

        <xpath expr="//input[@name='name']/.." position="after">
            <div
                t-attf-class="mb-3 #{error.get('firstname') and 'o_has_error' or ''} col-xl-6"
                t-att-hidden="partner.is_company"
            >
                <label class="col-form-label" for="firstname">First Name</label>
                <input
                    type="text"
                    name="firstname"
                    t-attf-class="form-control #{error.get('firstname') and 'is-invalid' or ''}"
                    t-att-value="firstname or partner.firstname"
                />
            </div>

            <div
                t-attf-class="mb-3 #{error.get('lastname') and 'o_has_error' or ''} col-xl-6"
                t-att-hidden="partner.is_company"
            >
                <label class="col-form-label" for="lastname">Last Name</label>
                <input
                    type="text"
                    name="lastname"
                    t-attf-class="form-control #{error.get('lastname') and 'is-invalid' or ''}"
                    t-att-value="lastname or partner.lastname"
                />
            </div>
        </xpath>
    </template>
</odoo>
