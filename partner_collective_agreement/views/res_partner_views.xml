<odoo>
    <record id="view_res_partner_form_inherit_collective_agreement" model="ir.ui.view">
        <field name="name">res.partner.form.collective.agreement.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button
                    name="action_view_collective_agreements"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    invisible="collective_agreement_count == 0"
                    string="Collective Agreements"
                >
                    <field name="collective_agreement_count" widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>
    <record id="action_partner_collective_agreements" model="ir.actions.act_window">
        <field name="name">Collective Agreements</field>
        <field name="res_model">collective.agreement</field>
        <field name="view_mode">list,form</field>
        <field
            name="domain"
        >[('partner_ids', 'in', [active_id]), ('active', '=', True)]</field>
    </record>
    <record
        id="view_res_partner_filter_inherit_collective_agreement"
        model="ir.ui.view"
    >
        <field name="name">res.partner.search.collective.agreement</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_by']" position="inside">
                <filter
                    string="Has Collective Agreement"
                    name="has_collective_agreement"
                    domain="[('collective_agreement_ids','!=',False)]"
                />
            </xpath>
        </field>
    </record>
</odoo>
