<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">partner.task.log.view.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//div[@name='button_box']/button[@name='action_view_tasks']"
                position="before"
            >
                <button
                    name="action_view_task_log"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-history"
                    groups="project.group_project_user"
                >
                    <field name="task_log_count" widget="statinfo" string="Task Log" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
