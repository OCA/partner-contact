<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="tree_res_partner_relation" model="ir.ui.view">
        <field name="model">res.partner.relation</field>
        <field
            name="inherit_id"
            ref="partner_multi_relation.tree_res_partner_relation"
        />
        <field name="arch" type="xml">
            <field name="right_partner_id" position="after">
                <field name="email" optional="hide" />
                <field name="phone" optional="hide" />
            </field>
        </field>
    </record>

    <record id="search_res_partner_relation" model="ir.ui.view">
        <field name="model">res.partner.relation</field>
        <field
            name="inherit_id"
            ref="partner_multi_relation.search_res_partner_relation"
        />
        <field name="arch" type="xml">
            <field name="right_partner_id" position="after">
                <field name="email" />
                <field name="phone" />
            </field>
        </field>
    </record>

    <record id="form_res_partner_relation" model="ir.ui.view">
        <field name="model">res.partner.relation</field>
        <field
            name="inherit_id"
            ref="partner_multi_relation.form_res_partner_relation"
        />
        <field name="arch" type="xml">
            <xpath expr="//group" position="before">
                <div class="oe_button_box" name="button_box">
                    <button
                        name="action_contact_address"
                        string="Contact address"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-users"
                    />
                </div>
            </xpath>
            <field name="right_partner_id" position="after">
                <field name="allow_contact_partner" invisible="1" />
                <field
                    name="contact_partner_id"
                    attrs="{
                    ' invisible': [('allow_contact_partner','=',False)],
                    ' readonly': [('allow_contact_partner','=',True)]}"
                />
                <field
                    name="email"
                    attrs="{
                    ' invisible': [('allow_contact_partner','=',False)],
                    ' readonly': [('allow_contact_partner','=',True)]}"
                />
                <field
                    name="phone"
                    attrs="{
                    ' invisible': [('allow_contact_partner','=',False)],
                    ' readonly': [('allow_contact_partner','=',True)]}"
                />
            </field>
        </field>
    </record>

</odoo>
