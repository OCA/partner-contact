<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_tree" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_mobile.view_partner_tree" />
        <field name="arch" type="xml">
            <field name="mobile" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </field>
        </field>
    </record>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_mobile.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='mobile']" position="attributes">
                <attribute name="invisible">is_company</attribute>
            </xpath>
            <xpath
                expr="//field[@name='child_ids']/form//div[@name='mobile']"
                position="attributes"
            >
                <attribute name="invisible">is_company</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_partner_simple_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_mobile.view_partner_simple_form" />
        <field name="arch" type="xml">
            <field name="mobile" position="attributes">
                <attribute name="invisible">is_company</attribute>
            </field>
        </field>
    </record>
</odoo>
