#. module: partner_identification
#: model_terms:ir.ui.view,arch_db:partner_identification.view_partner_id_category_form
msgid ""
"# Enter your validation code here # Use variable 'id_number' for the ID "
"number to validate # Set variable 'failed' to True if validation fails "
"failed = not id_number.name.isdigit()"
msgstr ""
"# Indtast din valideringskode her # Brug variablen 'id_number' for det ID-"
"nummer, der skal valideres # Sæt variablen 'failed' til True, hvis "
"valideringen mislykkes failed = not id_number.name.isdigit()"

#. module: partner_identification
#: model_terms:ir.ui.view,arch_db:partner_identification.view_partner_id_category_form
msgid ""
"# Use failed = True to specify that the id number is not valid.\n"
"# You can use the following variables :\n"
"#  - self: browse_record of the current ID Category browse_record\n"
"#  - id_number: browse_record of ID number to validate\n"
"\n"
"<b>\n"
"                                    <i># Sample 1: ID number only contains "
"digits</i>\n"
"                                </b>\n"
"if not id_number.name.isdigit():\n"
"    failed = True\n"
"else:\n"
"    failed = False\n"
"\n"
"<b>\n"
"                                    <i># Sample 2: Length of ID number "
"cannot exceed 10 chars</i>\n"
"                                </b>\n"
"failed = len(id_number.name) &gt; 10 and True or False\n"
"\n"
"<b>\n"
"                                    <i># Sample 3: ID number must start with "
"the category code</i>\n"
"                                </b>\n"
"failed = not id_number.name.startswith(self.code) and True or False"
msgstr ""
"# Brug failed = True til at angive, at ID-nummeret ikke er gyldigt.\n"
"# Du kan bruge følgende variabler:\n"
"#  - self: browse_record for den aktuelle ID-kategori\n"
"#  - id_number: browse_record for det ID-nummer, der skal valideres\n"
"\n"
"<b>\n"
"                                    <i># Eksempel 1: ID-nummer må kun "
"indeholde cifre</i>\n"
"                                </b>\n"
"if not id_number.name.isdigit():\n"
"    failed = True\n"
"else:\n"
"    failed = False\n"
"\n"
"<b>\n"
"                                    <i># Eksempel 2: ID-nummeret må ikke "
"overstige 10 tegn</i>\n"
"                                </b>\n"
"failed = len(id_number.name) &gt; 10 and True or False\n"
"\n"
"<b>\n"
"                                    <i># Eksempel 3: ID-nummer skal starte "
"med kategorikoden</i>\n"
"                                </b>\n"
"failed = not id_number.name.startswith(self.code) and True or False"

